# =============================================================================
# Vancouver Art Thieves — App (Expo client) environment variables
# =============================================================================
# This file is a TEMPLATE. Copy it to `.env` (gitignored) to configure the app:
#
#     copy app\.env.example app\.env
#
# Only variables prefixed with EXPO_PUBLIC_ are inlined into the client bundle
# at build/dev time, so after editing you must restart Metro / rebuild the app:
#
#     npx expo run:android
#
# See ENV.md (repo root) for the full reference.

# --- Server connection ---------------------------------------------------------

# Base URL of the game server (Express + Socket.IO).
#   Unset/empty -> auto-detected defaults:
#     iOS simulator / web : http://localhost:3001
#     Android emulator    : http://10.0.2.2:3001
#   Physical device      -> set to your computer's LAN IP on port 3001, e.g.
# EXPO_PUBLIC_API_URL=http://192.168.1.50:3001

# --- Map style -----------------------------------------------------------------

# MapLibre tile style URL. Unset to use the app's built-in minimal style.
# EXPO_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty

# --- Development helpers --------------------------------------------------------

# Keep React Native's built-in fetch as the global fetch instead of expo/fetch.
# expo/fetch can fail with "Network request failed" on Android release builds.
EXPO_PUBLIC_USE_RN_FETCH=1

# Simulate GPS movement for testing at home: auto-walks a route between landmarks
# and adds a dev panel on the Map screen to jump between landmarks.
# Keep unset or "false" to use the device's real location.
EXPO_PUBLIC_USE_MOCK_LOCATION=true

# --- Unused / reference ----------------------------------------------------------

# Google Maps API key. NOT used with MapLibre; kept only for reference.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
